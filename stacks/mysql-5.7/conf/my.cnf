[mysqld]
# Listen port
port=3306

# In Docker the basedir/datadir defaults are fine because the paths are
# already mapped by the host. Only set them when running outside a container.
# basedir=/data/env/mysql5.7
# datadir=/data/env/mysql5.7/data

# sql_mode=STRICT_TRANS_TABLES,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION
# Empty = lax mode for legacy applications that rely on MySQL 5.x behavior
sql_mode=

# Maximum number of concurrent client connections
max_connections=20000
# Number of consecutive failed connection attempts before the host is
# blocked (protects the server against brute-force connection attacks)
max_connect_errors=1000

# Server default character set
character-set-server=utf8mb4
# Default storage engine for new tables
default-storage-engine=INNODB
# Server collation.
# MySQL 8.0+ defaults to utf8mb4_0900_ai_ci (recommended).
# For MySQL 5.x keep the line below.
collation-server=utf8mb4_general_ci

# Authentication plugin for new users (mysql_native_password for 5.x
# compatibility with older clients)
default_authentication_plugin=mysql_native_password

# Server time zone (UTC+8)
default-time-zone='+8:00'

# server_id must be unique within the replication topology
server_id=100
# Databases excluded from the binary log (system schema, never replicated)
binlog-ignore-db=mysql
# Enable binary logging (required for replication and point-in-time recovery)
log-bin=mysql-bin
# Memory used per transaction while writing to the binary log
binlog_cache_size=1M
# Binary log format: mixed, statement or row
binlog_format=mixed

[mysql]
# Default character set for the mysql client
default-character-set=utf8mb4

[client]
# Default port and character set for client connections
port=3306
default-character-set=utf8mb4
