# Root path for all bind mounts of this stack.
# "." keeps data/ inside the stack directory.
ROOT_DIR=.

# Host port published for the MirrorProxy web UI / API
MIRRORPROXY_PORT=3000

# Publicly reachable base URL. Leave empty to let MirrorProxy infer it from
# the incoming request; set it when running behind a reverse proxy, e.g.
# https://mirror.example.com
MIRRORPROXY_PUBLIC_BASE_URL=

# Trusted reverse-proxy IPs/CIDRs used to resolve the real client IP.
# Add your proxy container IP or subnet when Nginx/Caddy sits in front.
MIRRORPROXY_TRUSTED_PROXIES=127.0.0.1,::1

# Timezone used for monthly quota accounting ("local" = system timezone)
MIRRORPROXY_QUOTA_TIMEZONE=local

# Admin password for the MirrorProxy web UI. When empty, the first start
# generates a random password and prints it to the container log.
MIRRORPROXY_ADMIN_PASSWORD=Admin123

# Log level configuration for the Rust server components
RUST_LOG=mirrorproxy_server=info,tower_http=info
