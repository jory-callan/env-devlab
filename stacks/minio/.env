# Root path for all bind mounts of this stack.
# "." keeps data/ inside the stack directory.
ROOT_DIR=.

# MinIO root credentials (S3 API + web console).
# The community image minio/minio was withdrawn from public registries in
# September 2026; this stack uses MinIO's official successor (AIStor Free).
# Keep the password at 8+ characters (MinIO requirement).
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456
