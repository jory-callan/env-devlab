# Root path for this stack (kept for convention uniformity; the component
# compose files below use paths relative to their own directory).
ROOT_DIR=.

# VictoriaLogs endpoint used by Fluent Bit (output) and Grafana (data source).
# On the shared net-shared network the service name resolves directly, so
# the default is the victorialogs container name, not 127.0.0.1.
VICTORIA_LOGS_HOST=victorialogs
VICTORIA_LOGS_PORT=9428

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123
