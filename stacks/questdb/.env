# Root path for all bind mounts of this stack.
# "." keeps data/ inside the stack directory.
ROOT_DIR=.

# PostgreSQL wire protocol credentials (port 8812)
QDB_PG_USER=admin
QDB_PG_PASSWORD=questdb
QDB_PG_READONLY_USER_ENABLED=true
QDB_PG_READONLY_USER=viewer
QDB_PG_READONLY_PASSWORD=questdb

# HTTP API credentials (Basic Auth, port 9000)
QDB_HTTP_ENABLED=true
QDB_HTTP_USER=admin
QDB_HTTP_PASSWORD=questdb
QDB_HTTP_SECURITY_READONLY=true
